{
  "name": "ecommerce-platform",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @ecommerce/backend --filter @ecommerce/storefront dev",
    "build": "corepack pnpm --filter @ecommerce/backend build && corepack pnpm --filter @ecommerce/storefront build",
    "lint": "corepack pnpm --filter @ecommerce/backend lint && corepack pnpm --filter @ecommerce/storefront lint",
    "typecheck": "corepack pnpm --filter @ecommerce/backend typecheck && corepack pnpm --filter @ecommerce/storefront typecheck",
    "health": "corepack pnpm --filter @ecommerce/backend health",
    "validate:env": "corepack pnpm --filter @ecommerce/backend validate:env && corepack pnpm --filter @ecommerce/storefront validate:env",
    "test:p0": "corepack pnpm exec playwright test --config=playwright.config.ts --max-failures=1",
    "test:backend": "corepack pnpm exec vitest run --config=vitest.config.ts --coverage",
    "test:ticket11": "node scripts/run-ticket11.mjs",
    "validate:csv": "node scripts/validate-p0-csv.mjs",
    "validate:docker:red": "node scripts/validate-docker-red.mjs",
    "test:docker:red": "node scripts/test-docker-red.mjs",
    "test:platform:red": "node scripts/run-platform-red.mjs",
    "validate:platform:refs": "node scripts/validate-platform-refs.mjs",
    "validate:gitops": "node scripts/validate-gitops.mjs",
    "platform:validate": "node scripts/validate-platform.mjs",
    "platform:validate:bootstrap": "node scripts/bootstrap-platform-tools.mjs",
    "platform:validate:refs": "node scripts/validate-platform.mjs refs",
    "platform:validate:app": "node scripts/validate-platform.mjs app",
    "platform:validate:terraform": "node scripts/validate-platform.mjs terraform",
    "platform:validate:helm": "node scripts/validate-platform.mjs helm",
    "platform:validate:gitops": "node scripts/validate-platform.mjs gitops",
    "platform:validate:schemas": "node scripts/validate-platform.mjs schemas",
    "platform:validate:policies": "node scripts/validate-platform.mjs policies",
    "platform:validate:docs": "node scripts/validate-platform.mjs docs",
    "platform:validate:kind": "PLATFORM_KIND_SMOKE=1 node scripts/validate-platform.mjs kind",
    "test:p0:all": "P0_GREP='TC-(00[1-9]|0[1-9][0-9]|[12][0-9][0-9]|3[0-9][0-9]|4[01][0-9]|420)' node scripts/run-ticket11.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
