{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "owner", "policies", "resources", "justification", "compensatingControl", "expiresAt", "reviewers"],
  "properties": {
    "id": { "type": "string", "pattern": "^EX-[0-9]{8}-[a-z0-9-]+$" },
    "owner": { "type": "string", "minLength": 1 },
    "policies": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "resources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["namespace", "name"] } },
    "justification": { "type": "string", "minLength": 20 },
    "compensatingControl": { "type": "string", "minLength": 20 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "reviewers": { "type": "array", "minItems": 2, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
